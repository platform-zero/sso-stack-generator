{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/platform-zero/sso-stack-generator/modules/stack.module.schema.json",
  "title": "SSO stack module metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "repo", "lifecycle", "smoke", "overlays"],
  "$defs": {
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "repoName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "safeOverlayPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!(?:/|.*(?:^|/)\\.\\.(?:/|$)|.*(?:^|/)\\.(?:/|$)))(?:stack\\.runtime\\.yaml|(?:global\\.settings|stack\\.compose|stack\\.config|stack\\.containers|stack\\.kotlin|stack\\.js|stack\\.systemd|scripts/lib|scripts/modules|docs/modules|tests/fixtures)(?:/.*)?)$"
    }
  },
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/$defs/moduleId"},
    "repo": {"$ref": "#/$defs/repoName"},
    "runtimeId": {"$ref": "#/$defs/moduleId"},
    "lifecycle": {
      "type": "string",
      "enum": ["active", "experimental", "retired"]
    },
    "dependencies": {
      "type": "array",
      "items": {"$ref": "#/$defs/moduleId"},
      "uniqueItems": true,
      "default": []
    },
    "runtimeDependencies": {
      "type": "array",
      "items": {"$ref": "#/$defs/moduleId"},
      "uniqueItems": true,
      "default": []
    },
    "contracts": {
      "type": "array",
      "items": {"$ref": "#/$defs/moduleId"},
      "uniqueItems": true,
      "default": []
    },
    "smoke": {
      "type": "string",
      "enum": ["required", "external-only", "unsupported"]
    },
    "smokeUnsupportedReason": {
      "type": "string",
      "minLength": 10
    },
    "ciProfiles": {
      "type": "array",
      "items": {"$ref": "#/$defs/moduleId"},
      "uniqueItems": true,
      "default": []
    },
    "overlays": {
      "type": "array",
      "items": {"$ref": "#/$defs/safeOverlayPath"},
      "minItems": 1,
      "uniqueItems": true
    },
    "sourceRepo": {"$ref": "#/$defs/repoName"},
    "testAssets": {
      "type": "array",
      "items": {"$ref": "#/$defs/safeOverlayPath"},
      "uniqueItems": true,
      "default": []
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"smoke": {"const": "required"}},
        "required": ["smoke"]
      },
      "then": {
        "not": {"required": ["smokeUnsupportedReason"]}
      },
      "else": {
        "required": ["smokeUnsupportedReason"]
      }
    }
  ]
}
